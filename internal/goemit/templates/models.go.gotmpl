func (dst *{{.TypeName}}) UnmarshalJSON(data []byte) error {
{{if .HasDiscriminator}}	var discriminator struct {
		Value string `json:"{{.DiscriminatorProperty}}"`
	}
	if err := json.Unmarshal(data, &discriminator); err != nil {
		return fmt.Errorf("decode {{.TypeName}} discriminator: %w", err)
	}
	switch discriminator.Value {
{{range .Mappings}}	case {{printf "%q" .Value}}:
		var decoded {{.FieldName}}
		if err := json.Unmarshal(data, &decoded); err != nil {
			return fmt.Errorf("decode {{$.TypeName}} as {{.FieldName}}: %w", err)
		}
		*dst = {{$.TypeName}}{ {{.FieldName}}: &decoded }
		return nil
{{end}}	default:
		return fmt.Errorf("unsupported {{.TypeName}} discriminator %q", discriminator.Value)
	}
{{else}}	return fmt.Errorf("{{.TypeName}} discriminator is missing")
{{end}}}
{{if .HasDiscriminator}}
