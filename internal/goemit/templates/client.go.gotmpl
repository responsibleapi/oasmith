	requestBody := bytes.NewReader(encodedBody)
{{end}}{{end}}{{else}}	var requestBody io.Reader
{{range .Params}}{{if .Body}}	if params.{{.FieldName}} != nil {
		encodedBody, err := json.Marshal(params.{{.FieldName}})
		if err != nil {
