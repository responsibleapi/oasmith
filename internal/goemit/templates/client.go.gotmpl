{{else}}		query.Set({{printf "%q" .WireName}}, fmt.Sprint(*params.{{.FieldName}}))
{{end}}	}
{{end}}{{end}}{{end}}	endpoint.RawQuery = query.Encode()
{{end}}{{if .MultipartBody}}	requestBody, contentType, err := new{{.ID}}MultipartBody(params)
	if err != nil {
