{{end}}
{{range .Params}}{{if .Path}}	path = strings.ReplaceAll(path, {{printf "%q" (printf "{%s}" .WireName)}}, url.PathEscape(fmt.Sprint({{if not .Required}}*{{end}}params.{{.FieldName}})))
{{end}}{{end}}	endpoint, err := url.Parse(c.baseURL + path)
	if err != nil {
