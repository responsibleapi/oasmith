{{else if .HasJSONBody}}{{if .RequiredJSONBody}}{{range .Params}}{{if .Body}}	encodedBody, err := json.Marshal(params.{{.FieldName}})
	if err != nil {
		return nil, fmt.Errorf("encode {{$operation.ID}} JSON body: %w", err)
