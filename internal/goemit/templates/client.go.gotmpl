{{else}}	query.Set({{printf "%q" .WireName}}, fmt.Sprint(params.{{.FieldName}}))
{{end}}{{else}}	if params.{{.FieldName}} != nil {
{{if .Slice}}		for _, value := range *params.{{.FieldName}} {
			query.Add({{printf "%q" .WireName}}, fmt.Sprint(value))
