		}
		requestBody = bytes.NewReader(encodedBody)
	}
{{end}}{{end}}{{end}}{{else if .HasRawBody}}	requestBody := params.Body
{{end}}	req, err := http.NewRequestWithContext(ctx, {{printf "%q" .Method}}, endpoint.String(), {{if .HasRequestBody}}requestBody{{else}}nil{{end}})
	if err != nil {
