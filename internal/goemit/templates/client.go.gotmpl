	}
{{if .HasQueryParams}}	query := endpoint.Query()
{{range .Params}}{{if .Query}}{{if .Required}}{{if .Slice}}	for _, value := range params.{{.FieldName}} {
		query.Add({{printf "%q" .WireName}}, fmt.Sprint(value))
